{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "moduleDetection": "force",
    "noImplicitAny": true,
    "paths": {
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
