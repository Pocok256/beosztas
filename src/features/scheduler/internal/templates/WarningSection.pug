section(class="card rounded-[2rem] border border-amber-300/60 bg-amber-50/80 shadow-xl backdrop-blur-xl")
  div(class="card-body gap-4 p-6 lg:p-7")
    div(class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between")
      div
        p.export-eyebrow Figyelmeztetesek
        h2.export-display.text-2xl.leading-tight Erdemes atnezni ezeket a pontokat
      span(class="badge badge-outline border-amber-300 bg-white/70 text-amber-700")= `${WARNING_COUNT} db`
    ul.warning-list.list-disc.pl-5.text-sm.leading-6.text-slate-700
      each warning in warnings
        li= warning
